# X API v2 app-only bearer token.
# Filtered stream needs pay-per-use credits or legacy Pro / Enterprise.
# Leave empty (or set MOCK=1) to run the simulated globe.
X_BEARER_TOKEN=

# Force simulated events even when a bearer token is present.
MOCK=

# OpenAI-compatible model used to read posts. Defaults to the xAI Grok API.
# LLM_API_KEY falls back to the platform XAI_API_KEY when unset.
LLM_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.5
